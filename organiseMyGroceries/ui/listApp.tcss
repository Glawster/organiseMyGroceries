/* Layout only. Colour comes from the shared OMP theme (myStyles.css). */

#content {
    height: 1fr;
    padding: 0 1;
}

#items {
    height: 1fr;
}

#status {
    height: 1;
    padding: 0 1;
}

ItemDialog,
NameDialog,
ConfirmDialog {
    align: center middle;
}

#item-box {
    width: 76;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    padding: 1 2;
}

#item-fields {
    height: auto;
    max-height: 21;
}

.field-row {
    height: 3;
}

.field-label {
    width: 18;
    height: 3;
    content-align: left middle;
}

.field-row Input {
    width: 1fr;
}

#item-error {
    display: none;
    height: auto;
    padding: 0 1;
}

#item-error.-visible {
    display: block;
}

#name-box {
    width: 60;
    max-width: 100%;
    height: auto;
    padding: 1 2;
}

#name-error {
    display: none;
    height: auto;
    padding: 0 1;
}

#name-error.-visible {
    display: block;
}

#lists {
    height: 1fr;
}
